rules_version = '2';

// Each student can read and write only their own profile and data:
//   users/{uid}                 profile (name, batch, student ID)
//   users/{uid}/data/{list}     courses, exams, schedule
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /data/{list} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
